<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sin este permiso Retrofit falla y la app no se conecta a la API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EquiposFutbol">

        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MenuActivity" android:exported="false" />
        <activity android:name=".EquiposActivity" android:exported="false" />
        <activity android:name=".EquipoFormActivity" android:exported="false" />
        <activity android:name=".UsuariosActivity" android:exported="false" />
        <activity android:name=".UsuarioFormActivity" android:exported="false" />

    </application>

</manifest>
